# The automation's texts, in English, the source of the other languages.

# The question before a client's first request, of the client's name.
automation-control-message = Allow “{ $client }” to control Lokyr?
automation-control-detail = It can open windows and tabs, type into your terminals, press keys, run Lokyr's commands and read what your terminals show, which may hold passwords and other secrets. Lokyr remembers your answer.
automation-control-terminal-detail = A program running in one of Lokyr's terminals asks to control Lokyr: it could type into your other terminals, run commands there and read what they show. Lokyr asks again for each program that runs.
automation-control-deny = Don't Allow
automation-control-allow = Allow
