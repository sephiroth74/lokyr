     fn window_event(&mut self, platform: &mut dyn Platform, window: WindowId, event: WindowEvent) {
+        let kind = match &event {
+            WindowEvent::Frame => "frame",
+            WindowEvent::Key(_) => "key",
+            WindowEvent::Resized(_) => "resized",
+            _ => "window",
+        };
+        let start = Instant::now();
         self.take_window_event(platform, window, event);
+        let took = start.elapsed();
         self.end_turn(platform);
+        probe_turn(kind, took, start.elapsed() - took, self.deliver_timer.is_some());
     }
 }
 
+/// The probe's line of a turn.
+fn probe_turn(kind: &str, took: Duration, ended: Duration, deliver: bool) {
+    eprintln!(
+        "probe turn {kind} {} {} {}",
+        took.as_micros(),
+        ended.as_micros(),
+        u8::from(deliver)
+    );
+}
