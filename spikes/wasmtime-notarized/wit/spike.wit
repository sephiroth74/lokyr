package lokyr:spike;

/// What the host offers to plugins.
interface host-log {
    /// Records a message from the plugin, such as a panic report.
    log: func(message: string);
}

/// Calls that measure the cost of crossing into a plugin.
interface bench {
    /// One node of a flat view tree: `children` holds indices into the list.
    record node {
        key: u32,
        kind: u8,
        label: string,
        children: list<u32>,
    }

    /// Prepares the plugin; the host calls it once, right after instantiation.
    init: func();

    /// Does nothing: measures the bare cost of a call.
    noop: func();

    /// Builds a view tree with `n` nodes, like a plugin rendering its UI.
    render: func(n: u32) -> list<node>;

    /// Runs a CPU-bound loop: measures how fast plugin code executes.
    work: func(iterations: u32) -> u64;

    /// Panics: shows what the host sees when plugin code fails.
    fail: func();

    /// A highlighted range of a line.
    record span {
        start: u32,
        len: u32,
        kind: u8,
    }

    /// Receives lines and returns their number: measures the cost of copying
    /// lines into the plugin.
    line-count: func(lines: list<string>) -> u32;

    /// Fuzzy-matches `query` against every line, like a command palette, and
    /// returns the indices of the lines that match.
    fuzzy: func(lines: list<string>, query: string) -> list<u32>;

    /// Splits every line into highlighted spans, like a syntax highlighter.
    highlight: func(lines: list<string>) -> list<list<span>>;
}

world plugin {
    import host-log;
    export bench;
}
