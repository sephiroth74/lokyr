<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE dictionary SYSTEM "file://localhost/System/Library/DTDs/sdef.dtd">
<!-- Lokyr's dictionary of AppleScript: its windows, their tabs and each
     tab's terminals, which the app reads through its automation. -->
<dictionary title="Lokyr Terminology">
    <suite name="Standard Suite" code="????" description="Common terms of every application.">
        <command name="get" code="coregetd" description="Get the data of an object.">
            <cocoa class="NSGetCommand"/>
            <access-group identifier="*"/>
            <direct-parameter type="specifier" description="The object."/>
            <result type="any" description="Its data."/>
        </command>
        <class name="application" code="capp" description="Lokyr." plural="applications">
            <cocoa class="NSApplication"/>
            <property name="name" code="pnam" type="text" access="r" description="The application's name."/>
            <property name="frontmost" code="pisf" type="boolean" access="r" description="Whether Lokyr is the application in front.">
                <cocoa key="isActive"/>
            </property>
        </class>
    </suite>
    <suite name="Lokyr Suite" code="LKyr" description="Lokyr's windows, tabs and terminals, and what a script does with them.">
        <enumeration name="split direction" code="LKsd" description="Where a split's new terminal goes.">
            <enumerator name="right" code="LKdR" description="On the right."/>
            <enumerator name="left" code="LKdL" description="On the left."/>
            <enumerator name="down" code="LKdD" description="Below."/>
            <enumerator name="up" code="LKdU" description="Above."/>
        </enumeration>
        <command name="create window" code="LKyrCrWn" description="Opens a window.">
            <cocoa class="LokyrCreateWindowCommand"/>
            <parameter name="with command" code="LKcm" type="text" optional="yes" description="A command line that its shell runs as it starts.">
                <cocoa key="command"/>
            </parameter>
            <parameter name="in folder" code="LKfd" type="text" optional="yes" description="The folder where its shell starts.">
                <cocoa key="folder"/>
            </parameter>
            <parameter name="with environment" code="LKev" optional="yes" description="Environment variables that its shell takes, each &quot;NAME=value&quot;, such as {&quot;EDITOR=vim&quot;}.">
                <type type="text" list="yes"/>
                <cocoa key="environment"/>
            </parameter>
            <result type="window" description="The window."/>
        </command>
        <command name="create tab" code="LKyrCrTb" description="Opens a tab, in the window in front unless another is given.">
            <cocoa class="LokyrCreateTabCommand"/>
            <parameter name="in window" code="LKwn" type="window" optional="yes" description="The window of the tab.">
                <cocoa key="window"/>
            </parameter>
            <parameter name="with command" code="LKcm" type="text" optional="yes" description="A command line that its shell runs as it starts.">
                <cocoa key="command"/>
            </parameter>
            <parameter name="in folder" code="LKfd" type="text" optional="yes" description="The folder where its shell starts.">
                <cocoa key="folder"/>
            </parameter>
            <parameter name="with environment" code="LKev" optional="yes" description="Environment variables that its shell takes, each &quot;NAME=value&quot;, such as {&quot;EDITOR=vim&quot;}.">
                <type type="text" list="yes"/>
                <cocoa key="environment"/>
            </parameter>
            <result type="tab" description="The tab."/>
        </command>
        <command name="split" code="LKyrSplt" description="Splits a terminal, the focused one unless another is given, of a new terminal beside it.">
            <cocoa class="LokyrSplitCommand"/>
            <direct-parameter type="terminal" optional="yes" description="The terminal to split."/>
            <parameter name="direction" code="LKdi" type="split direction" optional="yes" description="Where the new terminal goes, on the right unless told.">
                <cocoa key="direction"/>
            </parameter>
            <parameter name="with command" code="LKcm" type="text" optional="yes" description="A command line that its shell runs as it starts.">
                <cocoa key="command"/>
            </parameter>
            <parameter name="in folder" code="LKfd" type="text" optional="yes" description="The folder where its shell starts.">
                <cocoa key="folder"/>
            </parameter>
            <parameter name="with environment" code="LKev" optional="yes" description="Environment variables that its shell takes, each &quot;NAME=value&quot;, such as {&quot;EDITOR=vim&quot;}.">
                <type type="text" list="yes"/>
                <cocoa key="environment"/>
            </parameter>
            <result type="terminal" description="The new terminal."/>
        </command>
        <command name="input text" code="LKyrInpt" description="Sends text to a terminal, the focused one unless another is given, as if typed.">
            <cocoa class="LokyrInputTextCommand"/>
            <direct-parameter type="text" description="The text, of a return character to run a command line."/>
            <parameter name="to" code="LKto" type="terminal" optional="yes" description="The terminal.">
                <cocoa key="terminal"/>
            </parameter>
        </command>
        <command name="execute" code="LKyrExec" description="Runs a command line in a terminal's shell, the focused one unless another is given, at its prompt: Lokyr pastes it and presses Return, while the shell waits at an empty prompt, and refuses otherwise.">
            <cocoa class="LokyrExecuteCommand"/>
            <direct-parameter type="text" description="The command line, such as &quot;ls -la&quot;."/>
            <parameter name="to" code="LKto" type="terminal" optional="yes" description="The terminal.">
                <cocoa key="terminal"/>
            </parameter>
        </command>
        <command name="send key" code="LKyrSKey" description="Presses a key in a terminal, the focused one unless another is given, which takes the focus, as you press it in Lokyr: a key of a shortcut runs its command, as &quot;cmd+a&quot; selects all; another goes to the program as the keyboard sends it, of the modes that the program asked for. Option acts as Meta.">
            <cocoa class="LokyrSendKeyCommand"/>
            <direct-parameter type="text" description="The key and its modifiers, as a binding writes them, such as &quot;ctrl+c&quot;, &quot;up&quot; or &quot;shift+tab&quot;."/>
            <parameter name="to" code="LKto" type="terminal" optional="yes" description="The terminal.">
                <cocoa key="terminal"/>
            </parameter>
        </command>
        <command name="focus" code="LKyrFocs" description="Brings a window, a tab or a terminal forward.">
            <cocoa class="LokyrFocusCommand"/>
            <direct-parameter type="specifier" description="The window, tab or terminal."/>
        </command>
        <command name="close" code="coreclos" description="Closes windows, tabs or terminals; Lokyr asks first where a program other than a shell runs.">
            <cocoa class="LokyrCloseCommand"/>
            <direct-parameter type="specifier" description="The windows, tabs or terminals."/>
        </command>
        <command name="perform action" code="LKyrPerf" description="Runs one of Lokyr's commands by its name, as the command palette runs it, such as &quot;splits.split&quot;.">
            <cocoa class="LokyrPerformActionCommand"/>
            <direct-parameter type="text" description="The command's name."/>
            <parameter name="with arguments" code="LKar" type="any" optional="yes" description="Its arguments, such as {direction:&quot;right&quot;}.">
                <cocoa key="arguments"/>
            </parameter>
        </command>
        <!-- Each responds-to names the method that the classes and the
             application implement, which runs the command's own
             implementation; the commands of a text for their direct
             parameter respond of none, as their receiver is the
             application of its own. -->
        <class-extension extends="application" description="Lokyr's windows, and the commands that need no object of its own.">
            <element type="window" access="r" description="Its windows, the one in front first.">
                <cocoa key="lokyrWindows"/>
            </element>
            <responds-to command="create window">
                <cocoa method="lokyrPerformDefault:"/>
            </responds-to>
            <responds-to command="create tab">
                <cocoa method="lokyrPerformDefault:"/>
            </responds-to>
            <responds-to command="split">
                <cocoa method="lokyrPerformDefault:"/>
            </responds-to>
        </class-extension>
        <class name="window" code="cwin" description="A window of Lokyr's." plural="windows">
            <cocoa class="LokyrScriptWindow"/>
            <property name="id" code="ID  " type="integer" access="r" description="The window's id, which stays the same while Lokyr runs.">
                <cocoa key="uniqueID"/>
            </property>
            <property name="name" code="pnam" type="text" access="r" description="The window's title."/>
            <element type="tab" access="r" description="Its tabs, in their order.">
                <cocoa key="tabs"/>
            </element>
            <responds-to command="focus">
                <cocoa method="lokyrPerformDefault:"/>
            </responds-to>
            <responds-to command="close">
                <cocoa method="lokyrPerformDefault:"/>
            </responds-to>
        </class>
        <class name="tab" code="LKtb" description="A tab of a window." plural="tabs">
            <cocoa class="LokyrScriptTab"/>
            <property name="id" code="ID  " type="integer" access="r" description="The tab's id, which stays the same while Lokyr runs.">
                <cocoa key="uniqueID"/>
            </property>
            <property name="name" code="pnam" type="text" access="r" description="The tab's title."/>
            <element type="terminal" access="r" description="Its terminals, its panes.">
                <cocoa key="terminals"/>
            </element>
            <responds-to command="focus">
                <cocoa method="lokyrPerformDefault:"/>
            </responds-to>
            <responds-to command="close">
                <cocoa method="lokyrPerformDefault:"/>
            </responds-to>
        </class>
        <class name="terminal" code="LKtm" description="A terminal, a pane of a tab." plural="terminals">
            <cocoa class="LokyrScriptTerminal"/>
            <property name="id" code="ID  " type="integer" access="r" description="The terminal's id, which stays the same while Lokyr runs.">
                <cocoa key="uniqueID"/>
            </property>
            <property name="name" code="pnam" type="text" access="r" description="The terminal's title."/>
            <property name="working directory" code="LKwd" type="text" access="r" description="The folder where its shell works, as the shell told it.">
                <cocoa key="workingDirectory"/>
            </property>
            <property name="contents" code="LKct" type="text" access="r" description="The text that its screen shows. Lokyr asks you first whether the app that asks may read it.">
                <cocoa key="contents"/>
            </property>
            <property name="selected text" code="LKsl" type="text" access="r" description="Its selection's text. Lokyr asks you first whether the app that asks may read it.">
                <cocoa key="selectedText"/>
            </property>
            <responds-to command="split">
                <cocoa method="lokyrPerformDefault:"/>
            </responds-to>
            <responds-to command="focus">
                <cocoa method="lokyrPerformDefault:"/>
            </responds-to>
            <responds-to command="close">
                <cocoa method="lokyrPerformDefault:"/>
            </responds-to>
        </class>
    </suite>
</dictionary>
