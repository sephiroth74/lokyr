# vttest: the screens of its main tests, each marked where it asks for
# Return: cursor movements, screen features, character sets, VT102
# features and terminal reports. vttest sets mode 40, and the terminal
# lets it switch to 132 columns, as xterm does. `just record` builds
# vttest into target/vttest first.
size 80 24
copy ../../../../target/vttest/vttest
allow window-ops
run ./vttest
wait "Enter choice number"
mark menu
send "1\r"
quiet 500
mark movements-1
send "\r"
quiet 500
mark movements-2
send "\r"
quiet 500
mark movements-3
send "\r"
quiet 500
mark movements-4
send "\r"
quiet 500
mark movements-5
send "\r"
quiet 500
mark movements-6
send "\r"
quiet 500
send "2\r"
quiet 500
mark screen-1
send "\r"
quiet 500
mark screen-2
send "\r"
quiet 500
mark screen-3
send "\r"
quiet 500
mark screen-4
send "\r"
quiet 500
mark screen-5
send "\r"
quiet 500
mark screen-6
send "\r"
quiet 500
mark screen-7
send "\r"
quiet 500
mark screen-8
send "\r"
quiet 500
mark screen-9
send "\r"
quiet 500
mark screen-10
send "\r"
quiet 500
mark screen-11
send "\r"
quiet 500
mark screen-12
send "\r"
quiet 500
mark screen-13
send "\r"
quiet 500
mark screen-14
send "\r"
quiet 500
mark screen-15
send "\r"
quiet 500
send "3\r"
quiet 500
mark charsets
send "8\r"
quiet 500
mark vt100-sets-1
send "\r"
quiet 500
send "9\r"
quiet 500
mark shifts-1
send "\r"
quiet 500
send "10\r"
quiet 500
mark locking-shifts-1
send "\r"
quiet 500
send "11\r"
quiet 500
mark single-shifts-1
send "\r"
quiet 500
mark single-shifts-2
send "\r"
quiet 500
send "0\r"
quiet 500
send "8\r"
quiet 500
mark vt102-1
send "\r"
quiet 500
mark vt102-2
send "\r"
quiet 500
mark vt102-3
send "\r"
quiet 500
mark vt102-4
send "\r"
quiet 500
mark vt102-5
send "\r"
quiet 500
mark vt102-6
send "\r"
quiet 500
mark vt102-7
send "\r"
quiet 500
mark vt102-8
send "\r"
quiet 500
mark vt102-9
send "\r"
quiet 500
mark vt102-10
send "\r"
quiet 500
mark vt102-11
send "\r"
quiet 500
mark vt102-12
send "\r"
quiet 500
mark vt102-13
send "\r"
quiet 500
mark vt102-14
send "\r"
quiet 500
send "6\r"
quiet 500
mark reports
send "3\r"
quiet 500
mark dsr-1
send "\r"
quiet 500
send "4\r"
quiet 500
mark da-1
send "\r"
quiet 500
send "5\r"
quiet 500
mark da2-1
send "\r"
quiet 500
send "7\r"
quiet 500
mark decreqtparm-1
send "\r"
quiet 500
send "0\r"
quiet 500
mark menu-again
send "0\r"
exit
