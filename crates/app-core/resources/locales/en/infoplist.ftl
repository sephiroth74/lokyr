# The usage strings of the bundle's Info.plist, in English, the source of
# the other languages: what macOS shows as a program started in the
# terminal asks for what the privacy settings guard, which it asks on the
# terminal's behalf. Each message is the key of Info.plist that it fills.

NSMicrophoneUsageDescription = A program started in the terminal wants to use the microphone.
NSCameraUsageDescription = A program started in the terminal wants to use the camera.
NSAppleEventsUsageDescription = A program started in the terminal wants to control other apps.
NSDesktopFolderUsageDescription = A program started in the terminal wants to read the Desktop folder.
NSDocumentsFolderUsageDescription = A program started in the terminal wants to read the Documents folder.
NSDownloadsFolderUsageDescription = A program started in the terminal wants to read the Downloads folder.
NSRemovableVolumesUsageDescription = A program started in the terminal wants to read removable volumes.
NSNetworkVolumesUsageDescription = A program started in the terminal wants to read network volumes.
NSLocalNetworkUsageDescription = A program started in the terminal wants to reach devices on the local network.
NSBluetoothAlwaysUsageDescription = A program started in the terminal wants to use Bluetooth.
NSContactsUsageDescription = A program started in the terminal wants to read your contacts.
NSCalendarsFullAccessUsageDescription = A program started in the terminal wants to use your calendars.
NSRemindersFullAccessUsageDescription = A program started in the terminal wants to use your reminders.
NSPhotoLibraryUsageDescription = A program started in the terminal wants to read your photos.
NSLocationUsageDescription = A program started in the terminal wants to know your location.
NSSpeechRecognitionUsageDescription = A program started in the terminal wants to use speech recognition.

# The names of the files that Lokyr opens, which the Finder shows: iTerm2's
# color presets, and TOML files, Lokyr's themes among them.

document-type-itermcolors = iTerm2 Color Preset
document-type-toml = TOML Document
