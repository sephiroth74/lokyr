{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "lokyr/sample-slots",
  "type": "object",
  "properties": {
    "title": {
      "description": "The status bar's first text, before the tabs' count.",
      "type": "string",
      "minLength": 1,
      "maxLength": 30,
      "default": "sample-slots"
    },
    "place": {
      "description": "Where the tab bar goes.",
      "enum": ["titlebar", "below-titlebar", "bottom", "left", "right"],
      "default": "titlebar"
    },
    "width": {
      "description": "A column's width, in points, on the left or the right.",
      "type": "number",
      "minimum": 60,
      "maximum": 600,
      "default": 180
    }
  }
}
