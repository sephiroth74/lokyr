# I testi del kernel, in italiano.

program-exited = il programma è uscito con codice { $code }; un tasto chiude il pannello
program-signalled = il programma è terminato per il segnale { $signal }; un tasto chiude il pannello
program-ended = il programma è terminato; un tasto chiude il pannello
program-cannot-start = il programma non può partire: { $error }
scrollback-restored = Ripristinato da { $when }
