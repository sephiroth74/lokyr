# I testi del kernel, in italiano.

program-exited = il programma è uscito con codice { $code }; un tasto chiude la finestra
program-signalled = il programma è terminato per il segnale { $signal }; un tasto chiude la finestra
program-ended = il programma è terminato; un tasto chiude la finestra
program-cannot-start = il programma non può partire: { $error }
