# The kernel's texts, in English, the source of the other languages.

# The line of a pane whose program ended, until a key closes the pane.
program-exited = the program exited with code { $code }; a key closes the pane
program-signalled = the program ended by signal { $signal }; a key closes the pane
program-ended = the program ended; a key closes the pane
# The line of a window whose program could not start, with the system's
# error.
program-cannot-start = the program cannot start: { $error }
# The line under a pane's scrollback that opened again with its window,
# of the date and time that it was kept, as 2026-11-22 09:31.
scrollback-restored = Restored from { $when }
