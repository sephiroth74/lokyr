# The kernel's texts, in English, the source of the other languages.

# The line of a window whose program ended, until a key closes the window.
program-exited = the program exited with code { $code }; a key closes the window
program-signalled = the program ended by signal { $signal }; a key closes the window
program-ended = the program ended; a key closes the window
# The line of a window whose program could not start, with the system's
# error.
program-cannot-start = the program cannot start: { $error }
